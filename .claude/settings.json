{
  "extraKnownMarketplaces": {
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    }
  },
  "enabledPlugins": {
    "svelte@svelte": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["deepwiki", "playwright"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != true ] || bun install --cwd \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(mkdir:*)",
      "Edit",
      "Write"
    ],
    "deny": ["Read(**/.env)", "Edit(**/.env)"],
    "ask": ["Bash(bunx prisma db update*)", "Bash(bunx --bun prisma db update*)"]
  }
}
