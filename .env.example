# Directory for the SQLite database (gigorga.db)
DATA_DIR=data
# Port the server listens on
PORT=3000
# Public URL of the app; the OIDC callback is $ORIGIN/auth/callback
ORIGIN=http://localhost:5173
# Pocket ID (OIDC) issuer and the client created there for GigOrga
OIDC_ISSUER=http://localhost:1411
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Geocoding (Nominatim) and routing (OSRM) services used for the travel estimate
# GEOCODER_URL=https://nominatim.openstreetmap.org
# ROUTER_URL=https://router.project-osrm.org
