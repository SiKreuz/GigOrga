# Directory for the SQLite database (gigorga.db)
DATA_DIR=data
# Port the server listens on
PORT=3000
# Public URL of the app; set it if form posts are rejected behind a reverse proxy
# ORIGIN=https://gigs.example.com
# Geocoding (Nominatim) and routing (OSRM) services used for the travel estimate
# GEOCODER_URL=https://nominatim.openstreetmap.org
# ROUTER_URL=https://router.project-osrm.org
